---
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Mathías Terán — Fullstack Software Developer',
  description = 'Portfolio of Mathías Terán — Fullstack Software Developer specializing in web applications, APIs, architecture and digital products.',
  image = '/logo_myt.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.mathiast.me');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0909" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Mathías Terán" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mathías Terán",
      "url": "https://www.mathiast.me/",
      "jobTitle": "Fullstack Software Developer",
      "sameAs": [
        "https://github.com/MTDEV2312",
        "https://www.linkedin.com/in/math%C3%ADas-ter%C3%A1n-236727290"
      ]
    })} />
  </head>
  <body class="bg-[#0A0909] text-[#F1EDE6]">
    <slot />
  </body>
</html>
