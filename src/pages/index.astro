---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import App from '../components/portfolio/App';
import { getPortfolioData } from '../services/portfolioService';

const { projects, profile } = await getPortfolioData();
---

<PortfolioLayout
  title={`${profile.nombre} — Fullstack Software Developer`}
  description={profile.aboutMeDescription}
  image={profile.perfilUrl}
>
  <App client:load initialProjects={projects} profile={profile} />
</PortfolioLayout>
