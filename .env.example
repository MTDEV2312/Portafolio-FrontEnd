# Configuración de Supabase para Frontend
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Correos con privilegios de administrador (separados por coma si son varios)
PUBLIC_ADMIN_EMAILS=admin@ejemplo.com,otro@ejemplo.com

# URL de Deploy Hook de Vercel (Creala en Vercel Settings > Git > Deploy Hooks)
PUBLIC_VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/...